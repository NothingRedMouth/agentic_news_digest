# Telegram API
TELEGRAM_BOT_TOKEN=<bot token>
TELEGRAM_CHANNEL_ID=<channel id>
TELEGRAM_API_ID=<api id>
TELEGRAM_API_HASH=<api hash>
ALLOWED_USERS=<allowed users(user_id_1,user_id_2,...)>

# Message queue
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password


# Digest generation interval(0 = manual generation only)
DIGEST_INTERVAL_DAYS=7


# Google Sheets logging
GOOGLE_SHEETS_CREDENTIALS=/app/credentials/service_account.json
GOOGLE_SHEETS_NAME=AgentLogs


# LLM choice: external (external priority, local fallback),
#             openrouter_only (external only),
#             local (local_only)
LLM_PREFERENCE=external


# External LLM API(OpenAI format) 
EXTERNAL_API_KEY=<api key>
EXTERNAL_MODEL=deepseek-v4-flash
EXTERNAL_API_BASE_URL=https://api.deepseek.com
EXTERNAL_TIMEOUT=60
EXTERNAL_MAX_TOKENS=30000


# Local LLM
LOCAL_LLM_SERVER_URL=http://localhost:8080
LOCAL_LLM_TIMEOUT=300
LOCAL_LLM_MAX_TOKENS=30000
LOCAL_LLM_RETRIES=3
LOCAL_LLM_REPEAT_PENALTY=1.1


# Email newsletter
UNISENDER_API_KEY=<api>
UNISENDER_SENDER_EMAIL=<email>
UNISENDER_SENDER_NAME=<sender name>
UNISENDER_LIST_ID=<id>
