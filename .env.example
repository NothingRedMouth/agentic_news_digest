TELEGRAM_BOT_TOKEN=TOKEN HERE
TELEGRAM_CHANNEL_ID=CHANNEL ID HERE
TELEGRAM_API_ID=API ID HERE
TELEGRAM_API_HASH=API HASH HERE
ALLOWED_USERS=ALLOWED USERS HERE

OPENROUTER_API_KEY=KEY HERE
OPENROUTER_MODEL=google/gemma-4-31b-it:free

EXA_API_KEY=KEY HERE

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password

NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Скоуп поиска: telegram_only(default), telegram+web, web_only
SEARCH_SCOPE=telegram_only

# Выбор LLM: openrouter (приоритет OpenRouter, fallback локальная),
#            openrouter_only (только OpenRouter, ошибка если недоступен),
#            local (только локальная модель)
LLM_PREFERENCE=openrouter

# Путь к локальной модели
LOCAL_MODEL_PATH=/app/models/gemma-4-31B-it-UD-Q4_K_XL.gguf

# Интервал автоматического запуска дайджеста в днях (0 или пусто = отключено)
DIGEST_INTERVAL_DAYS=7

GOOGLE_SHEETS_CREDENTIALS=/app/credentials/service_account.json
GOOGLE_SHEETS_NAME=AgentLogs

# получение их происходит в https://app.unisender.com
UNISENDER_API_KEY=KEY HERE
UNISENDER_SENDER_EMAIL=U EMAIL HERE
UNISENDER_SENDER_NAME=U NAME HERE
UNISENDER_LIST_ID=ID HERE
