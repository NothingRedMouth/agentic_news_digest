TELEGRAM_BOT_TOKEN=ВАШ_ТОКЕН_БОТА
TELEGRAM_CHANNEL_ID=ВАШ_АЙДИ_ТЕЛЕГРАМ_КАНАЛА
ALLOWED_USERS=РАЗРЕШЁННЫЕ_ПОЛЬЗОВАТЕЛИ_ЧЕРЕЗ_ЗАПЯТУЮ

OPENROUTER_API_KEY=ВАШ_КЛЮЧ_OPENROUTER
OPENROUTER_MODEL=google/gemma-4-31b-it:free

EXA_API_KEY=ВАШ_КЛЮЧ_EXA

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password

# Скоуп поиска: telegram_only(default), telegram+web, web_only
SEARCH_SCOPE=telegram_only

# Выбор LLM: openrouter (приоритет OpenRouter, fallback локальная),
#            openrouter_only (только OpenRouter, ошибка если недоступен),
#            local (только локальная модель)
LLM_PREFERENCE=openrouter

# Путь к локальной модели
LOCAL_MODEL_PATH=/app/models/gemma-4-31B-it-UD-Q4_K_XL.gguf

# Интервал автоматического запуска дайджеста в днях (0 или пусто = отключено)
DIGEST_INTERVAL_DAYS=7
